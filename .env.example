# ═══════════════════════════════════════════════════════════
#  StudyOS — Ortam Değişkenleri Şablonu
#  Bu dosyayı kopyalayın: cp .env.example .env
#  GERÇEK DEĞERLERI .env dosyasına girin, asla commit etmeyin
# ═══════════════════════════════════════════════════════════

# ── Uygulama ────────────────────────────────────────────────
APP_NAME=StudyOS
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── Veritabanı ──────────────────────────────────────────────
POSTGRES_USER=studyos
POSTGRES_PASSWORD=studyos
POSTGRES_DB=studyos_dev
DATABASE_URL=postgresql+asyncpg://studyos:studyos@localhost:5432/studyos_dev
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AWS S3 / MinIO (Geliştirmede MinIO kullanılır) ──────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=studyos-dev
# Geliştirmede: http://localhost:9000 | Üretimde: boş bırak
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ── MinIO (Docker) ──────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=
AI_PROVIDER=gemini

# ── Firebase (FCM) ──────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# ── E-posta (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@studyos.com
SMTP_FROM_NAME=StudyOS

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
