# ═══════════════════════════════════════════════════════════
#  StudyOS — Ortam Değişkenleri Şablonu
#  Bu dosyayı kopyalayın: cp .env.example .env
#  GERÇEK DEĞERLERI .env dosyasına girin, asla commit etmeyin
# ═══════════════════════════════════════════════════════════

# ── Uygulama ────────────────────────────────────────────────
APP_NAME=StudyOS
# development | beta | production  (beta/production → secret guard aktif)
APP_ENV=development
DEBUG=true
# RC2 M22.5 — prod/beta'da change-me / boş / kısa değer YASAK
APP_SECRET=change-me-use-openssl-rand-hex-32
SECRET_KEY=change-me-use-openssl-rand-hex-32
COOKIE_SECRET=change-me-use-openssl-rand-hex-32

# ── Veritabanı ──────────────────────────────────────────────
POSTGRES_USER=studyos
POSTGRES_PASSWORD=studyos
POSTGRES_DB=studyos_dev
# Yerel: docker compose postgres
DATABASE_URL=postgresql+asyncpg://studyos:studyos@localhost:5432/studyos_dev
# Neon (Render): postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# (uygulama otomatik +asyncpg / ssl=require yapar)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── JWT ─────────────────────────────────────────────────────
# prod/beta: openssl rand -hex 32  (change-me yasak)
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AWS S3 / MinIO (Geliştirmede MinIO kullanılır) ──────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=eu-central-1
AWS_S3_BUCKET_NAME=studyos-dev
# Geliştirmede: http://localhost:9000 | Üretimde: boş bırak
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ── MinIO (Docker) ──────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── AI (Sprint-2.4) ─────────────────────────────────────────
# AI_PROVIDER: null | gemini | openai | claude  (varsayılan güvenli: null)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=null
# Günün Denemesi kitapçık: true veya AI_PROVIDER=null → sentetik sorular (hızlı)
# ASSESSMENT_BOOKLET_SYNTHETIC=false
AI_MODEL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=2
AI_RATE_LIMIT_PER_MINUTE=20
AI_FALLBACK_PROVIDER=null
AI_GEMINI_MAX_FALLBACKS=1
AI_DAILY_REQUEST_BUDGET=1000

# ── M32 Production readiness / cost (dev: hepsi kapalı) ──
ENABLE_AUTO_BOOKLET=false
ENABLE_BACKGROUND_AI=false
ENABLE_MIDNIGHT_SCHEDULER=false
ENABLE_CATCHUP=false
ENABLE_AI_WARMUP=false
ENABLE_COMPACT_AUTHOR=true

# ── Knowledge Layer (Sprint-19) ─────────────────────────────
# notebooklm | local  — UI'da marka yok; provider arka planda
KNOWLEDGE_PROVIDER=notebooklm

# ── Firebase (FCM) ──────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=

# ── E-posta (SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@studyos.com
SMTP_FROM_NAME=StudyOS
PASSWORD_RESET_EXPIRE_MINUTES=15
# Şifre sıfırlama linki tabanı (admin reset sayfası buraya bağlanır)
PUBLIC_APP_URL=http://127.0.0.1:8002

# ── Admin bootstrap (startup) ───────────────────────────────
ADMIN_BOOTSTRAP_EMAIL=kadirkartal4921@icloud.com
ADMIN_BOOTSTRAP_PASSWORD=Kadir_kartal49
ADMIN_BOOTSTRAP_FIRST_NAME=Kadir
ADMIN_BOOTSTRAP_LAST_NAME=Kartal

# ── Sentry ──────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
