# ─────────────────────────────────────────────
#  StudyOS — Root .gitignore
# ─────────────────────────────────────────────

# ── Ortam Değişkenleri (ASLA commit edilmez) ──
.env
.env.*
!.env.example

# ── İşletim Sistemi ──────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editör / IDE ──────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*~
.cursor/

# ── Python / FastAPI ──────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.log
.uv/
venv/
.venv/
env/

# ── Flutter / Dart ────────────────────────────
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/pubspec.lock
!backend/uv.lock

# ── Android ──────────────────────────────────
mobile/android/.gradle/
mobile/android/captures/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/**/*.keystore
mobile/android/**/*.jks
mobile/android/app/google-services.json
mobile/ios/Runner/GoogleService-Info.plist

# ── iOS / macOS ──────────────────────────────
mobile/ios/.symlinks/
mobile/ios/Pods/
*.ipa

# ── Docker ───────────────────────────────────
docker-compose.override.yml

# ── Geçici Dosyalar ───────────────────────────
*.tmp
*.temp
*.bak
# Build logs
**/build_log.txt
**/buildlog.txt

# Dependency dumps
**/deps.txt
**/pubdeps.txt

# AI cost logs
data/ai_cost/

# Uploaded resources
data/uploads/
test.dart
test2.dart

# ── Local SQLite databases ───────────────────
*.db

# ── Local analysis / measurement artifacts ───
data/analysis/

# ── Local export / scratch files ─────────────
backend/canli_sorular.csv
backend/analyze_db.py
backend/export_questions.py
backend/export_sync.py

# ── Local measurement / generation scripts ───
backend/scripts/_*.py
backend/scripts/analyze_*.py
backend/scripts/build_*.py
backend/scripts/extract_*.py
backend/scripts/run_*.py

# ── Validation temp scripts ──────────────────
_val*.py
_test*.py
_validate*.py
backend/_tmp_*

# ── Local Gradle cache (Android distribute) ──
.gradle-user-home/

